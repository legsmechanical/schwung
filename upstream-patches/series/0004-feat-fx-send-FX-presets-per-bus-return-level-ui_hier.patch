+                                            else if (*obj_end == '}') depth--;
+                                            obj_end++;
+                                        }
+                                        int hlen = (int)(obj_end - obj_start);
+                                        if (hlen > 0 && hlen < SHADOW_PARAM_VALUE_LEN - 1) {
+                                            memcpy(shadow_param->value, obj_start, hlen);
+                                            shadow_param->value[hlen] = '\0';
