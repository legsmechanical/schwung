+                        fseek(f, 0, SEEK_END);
+                        long size = ftell(f);
+                        fseek(f, 0, SEEK_SET);
+                        if (size > 0 && size < 65536) {
+                            char *json = malloc(size + 1);
+                            if (json) {
+                                size_t nread = fread(json, 1, size, f);
+                                json[nread] = '\0';
+
+                                const char *ui_hier = strstr(json, "\"ui_hierarchy\"");
+                                if (ui_hier) {
