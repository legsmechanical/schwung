From f9ea099b286ee05a50b5a31221ef3678fa0d4ced Mon Sep 17 00:00:00 2001
From: legsmechanical <joshgaine@gmail.com>
Date: Wed, 10 Jun 2026 11:47:09 -0400
Subject: [PATCH] fix(fx): keep Move FX strip independent of synth slot
 mute/solo
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Revert the mute/solo coupling from 29e77454. Gating the Move FX strip by the
synth slot's mute/solo recouples exactly what Move>Slot decouples — the whole
point is that the peeled Move track is independent of the synth on the same
channel. The Move FX strip uses its own volume only (set it to 0 to silence;
Move's native track mute still silences the source). Drop the now-unused
shadow_slot_active_gain() helper. The other 29e77454 fixes (idle gating, Move FX
block relocation + relaxed synth idle gate, per-set strip reset) are unaffected.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 src/host/shadow_chain_mgmt.h | 10 ----------
 src/schwung_shim.c           |  7 ++++---
 2 files changed, 4 insertions(+), 13 deletions(-)

diff --git a/src/host/shadow_chain_mgmt.h b/src/host/shadow_chain_mgmt.h
index 4d930684..ccef8390 100644
--- a/src/host/shadow_chain_mgmt.h
+++ b/src/host/shadow_chain_mgmt.h
@@ -167,16 +167,6 @@ static inline float shadow_effective_volume(int slot) {
     return shadow_chain_slots[slot].volume;
 }
 
-/* Mute/solo gate (0.0 or 1.0) independent of slot volume. The Move FX strip
- * carries its own volume but should still obey the channel's mute/solo like
- * every other audio path. Solo wins over mute, matching shadow_effective_volume. */
-static inline float shadow_slot_active_gain(int slot) {
-    if (shadow_solo_count > 0) {
-        return shadow_chain_slots[slot].soloed ? 1.0f : 0.0f;
-    }
-    return shadow_chain_slots[slot].muted ? 0.0f : 1.0f;
-}
-
 /* Advance the fade envelope by one sample. Call once per stereo frame in mix loop. */
 static inline void shadow_fade_advance(int slot) {
     slot_fade_t *f = &shadow_chain_slots[slot].fade;
diff --git a/src/schwung_shim.c b/src/schwung_shim.c
index 5f6aac72..708f17a4 100644
--- a/src/schwung_shim.c
+++ b/src/schwung_shim.c
@@ -2140,9 +2140,10 @@ static void shadow_inprocess_mix_from_buffer(void) {
                     }
                     msrc = mbuf;
                 }
-                /* Strip volume × the channel's mute/solo gate (not the synth
-                 * slot volume — the Move FX strip has its own level). */
-                float mvol = shadow_move_fx_strip[s].volume * shadow_slot_active_gain(s);
+                /* The Move FX strip is fully independent of the synth slot on
+                 * this channel — its own volume only, deliberately NOT gated by
+                 * the synth slot's mute/solo (that independence is the feature). */
+                float mvol = shadow_move_fx_strip[s].volume;
                 for (int i = 0; i < FRAMES_PER_BLOCK * 2; i++) {
                     int32_t scaled = (int32_t)lroundf((float)msrc[i] * mvol);
                     int32_t mixed = (int32_t)mailbox_audio[i] + scaled;
-- 
