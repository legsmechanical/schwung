 src/modules/chain/dsp/chain_host.c | 177 ++++++++++++-----------------
 src/shadow/shadow_ui.js            |  40 ++++---
 2 files changed, 99 insertions(+), 118 deletions(-)

diff --git a/src/modules/chain/dsp/chain_host.c b/src/modules/chain/dsp/chain_host.c
