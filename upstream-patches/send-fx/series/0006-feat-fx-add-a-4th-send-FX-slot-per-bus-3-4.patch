From 70715d3af231771906e4039cbad3943aed834a34 Mon Sep 17 00:00:00 2001
From: legsmechanical <joshgaine@gmail.com>
Date: Thu, 4 Jun 2026 10:11:39 -0400
Subject: [PATCH] feat(fx): add a 4th send FX slot per bus (3 -> 4)

Brings sends to parity with Master FX (4 slots). The design was already
parameterized, so this is mechanical:
- SEND_FX_SLOTS 3 -> 4 (resizes shadow_send_fx_slots, audio/unload loops).
- Add fx4 case to both send-key parsers in shadow_chain_mgmt.c.
- Add fx4 to build_send_preset_json (buffer already sized for 4 slots).
- JS: 4th entry in SEND_FX_COMPONENTS_A/B, slotCount 3 -> 4 (both buses),
  SEND_FX_SLOTS_JS 3 -> 4.

No state-version bump: old presets / per-set auto-persist files without fx4
load it empty (backward compatible).

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 src/host/shadow_chain_mgmt.c       |  2 ++
 src/host/shadow_chain_mgmt.h       |  2 +-
 src/modules/chain/dsp/chain_host.c |  8 +++++---
 src/shadow/shadow_ui.js            | 12 +++++++-----
 4 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/src/host/shadow_chain_mgmt.c b/src/host/shadow_chain_mgmt.c
index abc32417..9fbeb0f4 100644
--- a/src/host/shadow_chain_mgmt.c
+++ b/src/host/shadow_chain_mgmt.c
@@ -1884,6 +1884,7 @@ void shadow_direct_set_param(uint8_t slot, const char *key, const char *value) {
         if      (strncmp(rest, "fx1:", 4) == 0) { sfx_slot = 0; rest += 4; }
         else if (strncmp(rest, "fx2:", 4) == 0) { sfx_slot = 1; rest += 4; }
         else if (strncmp(rest, "fx3:", 4) == 0) { sfx_slot = 2; rest += 4; }
+        else if (strncmp(rest, "fx4:", 4) == 0) { sfx_slot = 3; rest += 4; }
         if (sfx_slot < 0) return;
 
         master_fx_slot_t *sfx = &shadow_send_fx_slots[bus][sfx_slot];
@@ -2866,6 +2867,7 @@ void shadow_inprocess_handle_param_request(void) {
         if      (strncmp(rest, "fx1:", 4) == 0) { sfx_slot = 0; rest += 4; }
         else if (strncmp(rest, "fx2:", 4) == 0) { sfx_slot = 1; rest += 4; }
         else if (strncmp(rest, "fx3:", 4) == 0) { sfx_slot = 2; rest += 4; }
+        else if (strncmp(rest, "fx4:", 4) == 0) { sfx_slot = 3; rest += 4; }
         if (sfx_slot < 0) {
             shadow_param->error = 1;
             shadow_param->result_len = -1;
diff --git a/src/host/shadow_chain_mgmt.h b/src/host/shadow_chain_mgmt.h
index a870c76d..64700b55 100644
--- a/src/host/shadow_chain_mgmt.h
+++ b/src/host/shadow_chain_mgmt.h
@@ -20,7 +20,7 @@
 
 #define MASTER_FX_SLOTS 4
 #define SEND_BUS_COUNT 2
-#define SEND_FX_SLOTS  3
+#define SEND_FX_SLOTS  4
 #define SHADOW_CHAIN_MODULE_DIR "/data/UserData/schwung/modules/chain"
 #define SHADOW_CHAIN_DSP_PATH "/data/UserData/schwung/modules/chain/dsp.so"
 
